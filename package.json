{
  "name": "mockjs",
  "title": "Mock.js",
  "description": "生成随机数据 & 拦截 Ajax 请求",
  "version": "1.0.1-beta3",
  "homepage": "http://mockjs.com/",
  "keywords": [
    "mock",
    "mockJSON",
    "mockAjax"
  ],
  "author": "nuysoft@gmail.com",
  "type": "module",
  "main": "./dist/mock.js",
  "module": "./dist/mock.esm.js",
  "exports": {
    ".": {
      "import": "./dist/mock.esm.js",
      "require": "./dist/mock.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^5.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nuysoft/Mock.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest --coverage",
    "lint": "eslint src test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "bin": {
    "random": "bin/random"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/nuysoft/Mock/blob/master/LICENSE"
    }
  ]
}
