{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "target": "ES5",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": false,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": false,
        "outDir": "./tsbuild",
        "rootDir": "./src",
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
